NODE_ENV=development
HOST=127.0.0.1
PORT=3001
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/hellar.sqlite
STORAGE_PATH=./data/files
COOKIE_SECURE=false
TRUST_PROXY=false
OPENAI_API_KEY=
CHAT_MODELS=gpt-4.1-mini
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_SIZES=1024x1024,1024x1536,1536x1024
CHAT_DAILY_LIMIT=100
IMAGE_DAILY_LIMIT=10
GLOBAL_CHAT_DAILY_LIMIT=1000
GLOBAL_IMAGE_DAILY_LIMIT=100
MAX_OUTPUT_TOKENS=1500
MAX_CONTEXT_CHARS=48000
AI_TIMEOUT_MS=90000
IMAGE_TIMEOUT_MS=180000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# HTTP email delivery (Cloudflare); SMTP remains available for the Node server.
RESEND_API_KEY=
# Real verified sender, e.g. Hellar AI <no-reply@your-domain.example>
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Captcha is mandatory in production, and enabled locally when either key is set.
