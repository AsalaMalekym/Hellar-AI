{
  "name": "hellar-ai-cosmic",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch server/index.ts",
    "build": "tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "test": "node --import tsx --test --test-concurrency=1 tests/*.test.ts tests/*.test.tsx",
    "admin:create": "node --env-file-if-exists=.env --import tsx server/admin.ts",
    "migrate": "node --env-file-if-exists=.env --import tsx server/migrate.ts",
    "checkpoint": "python3 scripts/checkpoint.py",
    "format": "prettier --write src server tests scripts/dev.mjs vite.config.ts",
    "admin:create:prod": "node --env-file-if-exists=.env dist-server/server/admin.js",
    "migrate:prod": "node --env-file-if-exists=.env dist-server/server/migrate.js",
    "build:cloudflare": "tsc --noEmit && tsc --noEmit -p cloudflare/tsconfig.json && vite build && node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "test:cloudflare": "node scripts/test-cloudflare.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.2.1",
    "@fastify/static": "^10.1.10",
    "fastify": "^5.6.2",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.4.0",
    "openai": "^6.9.0",
    "pngjs": "7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.3",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "esbuild": "0.28.2",
    "miniflare": "4.20260515.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wrangler": "4.92.0"
  }
}
